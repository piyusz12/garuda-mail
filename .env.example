# ==============================================================================
# GARUDA (SIH26159) — Master Environment Configuration Template
# Copy this file to .env or .env.local and configure suitable values.
# NEVER commit production credentials, passwords, or private keys to source control.
# ==============================================================================

# ── 1. FRONTEND CONFIGURATION (Next.js / Port 3000) ──────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="garuda-dev-secret-change-this-for-production-deployment-min32bytes"
AUTH_TRUST_HOST="true"

# Host & Port for LAN Binding (0.0.0.0 allows connections from other PCs on the same LAN)
HOST="0.0.0.0"
PORT=3000

# ── 2. DATABASE CONFIGURATION (PostgreSQL / Prisma) ──────────────────────────
# For PostgreSQL production / local instance:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/garuda_mail?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/garuda_mail?schema=public"

# ── 3. FORENSIC BACKEND CONFIGURATION (FastAPI / Port 8000) ──────────────────
GARUDA_BACKEND_URL="http://127.0.0.1:8000"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
GARUDA_API_KEY="garuda-forensic-api-key-change-in-production"

# Ingestion bounds
MAX_UPLOAD_SIZE_MB=50
PCAP_STORAGE_PATH="./email-forensic-framework/pcaps"
OUTPUT_STORAGE_PATH="./email-forensic-framework/output"

# ── 4. TLS & CERTIFICATE CONFIGURATION ───────────────────────────────────────
# Local LAN HTTPS paths
TLS_CERT_PATH="./certs/server.crt"
TLS_KEY_PATH="./certs/server.key"
CA_CERT_PATH="./certs/rootCA.pem"

# ── 5. AI & ANOMALY DETECTION CONFIGURATION ──────────────────────────────────
AI_MODEL_PATH="./email-forensic-framework/models"
ISOLATION_FOREST_CONTAMINATION=0.05
ANOMALY_THRESHOLD=0.75
RANDOM_SEED=42

# ── 6. EMAIL PROTOCOL CONFIGURATION (Optional Relay Testing) ─────────────────
# Gmail SMTP App Password (Optional for external internet email relay demonstration)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# ── 7. APPLICATION & DEMO FLAGS ──────────────────────────────────────────────
APP_NAME="GARUDA Mail & Sentinel"
DEMO_MODE="true"
NEXT_PUBLIC_DEMO_MODE="true"
LOG_LEVEL="info"
