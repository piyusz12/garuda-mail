# Garuda Mail — Environment Variables
# Copy this file to .env.local and fill in the values

# ── Database (Supabase) ──────────────────────────────────────────────
# Get these from your Supabase project → Settings → Database → Connection String
# Use "Transaction" mode URL for DATABASE_URL and "Session" mode for DIRECT_URL
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ── NextAuth ─────────────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ── Runtime / AI services ───────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
MODEL_SERVER_URL="http://localhost:8000"
OLLAMA_URL="http://localhost:11434"
VLLM_URL="http://localhost:8000"
VECTOR_DB_PATH="./data/vector"
STORAGE_PATH="./data/storage"
LOG_LEVEL="info"
CORS_ORIGINS="http://localhost:3000"
DEMO_MODE="true"
AIR_GAPPED_MODE="false"

# ── Gmail SMTP ───────────────────────────────────────────────────────
# Use a Gmail App Password (NOT your regular password)
# Enable at: Google Account → Security → 2-Step Verification → App Passwords
GMAIL_USER="your-gmail@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# ── App Config ───────────────────────────────────────────────────────
APP_NAME="Garuda Mail"
APP_URL="http://localhost:3000"
